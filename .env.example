# Base application URLs
BASE_URL=https://your-app.example.com
API_BASE_URL=https://your-app.example.com

# Common routes
LOGIN_PATH=/login
DASHBOARD_PATH=/dashboard
PROTECTED_PATH=/dashboard

# Credentials for a stable non-production account
USER_EMAIL=test.user@example.com
USER_PASSWORD=change-me
INVALID_PASSWORD=bad-password

# Configurable API endpoints
HEALTH_ENDPOINT=/health
PROFILE_ENDPOINT=/api/me

# Optional tuning
DEFAULT_TIMEOUT_MS=10000
EXPECT_TIMEOUT_MS=10000
